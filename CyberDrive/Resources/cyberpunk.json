{
  "version": 8,
  "name": "CyberDrive Cyberpunk",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#05030d" } },
    { "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "paint": { "fill-color": "#0b1420", "fill-opacity": 0.75 } },
    { "id": "landuse", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "paint": { "fill-color": "#0a0a14", "fill-opacity": 0.9 } },
    { "id": "parks", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "#071b20", "fill-opacity": 0.9 } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#08182d" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": { "line-color": "#0e5d82", "line-opacity": 0.75, "line-width": 1.5 } },
    { "id": "buildings", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#131022", "fill-outline-color": "#352052", "fill-opacity": 0.95 } },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "paint": {
        "line-color": "#29134b",
        "line-opacity": 0.9,
        "line-width": { "stops": [[10, 1], [14, 4], [18, 10]] },
        "line-blur": 1.5
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "paint": {
        "line-color": "#41506b",
        "line-opacity": 0.95,
        "line-width": { "stops": [[10, 0.5], [14, 2], [18, 5]] }
      }
    },
    {
      "id": "motorways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#9b2cff",
        "line-opacity": 0.9,
        "line-width": { "stops": [[8, 1], [12, 3], [16, 7]] },
        "line-blur": 0.5
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": { "stops": [[13, 8], [16, 12]] },
        "text-letter-spacing": 0.08,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#58e8ff",
        "text-halo-color": "#05030d",
        "text-halo-width": 2
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": { "stops": [[6, 10], [10, 15], [14, 19]] },
        "text-letter-spacing": 0.12
      },
      "paint": {
        "text-color": "#f400a7",
        "text-halo-color": "#05030d",
        "text-halo-width": 3
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 9,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#b88cff",
        "text-halo-color": "#05030d",
        "text-halo-width": 2
      }
    }
  ]
}
